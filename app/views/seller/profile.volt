{% extends 'layouts/main.volt' %}
{% block content %}
<main class="seller-shell"><aside class="seller-sidebar"><div class="seller-avatar">{{ sellerName|slice(0,1)|upper }}</div><b>{{ sellerProfile.nama_usaha|e }}</b><small>Area Seller</small><nav><a href="{{ url('seller') }}">▦　Dashboard</a><a href="{{ url('seller/tambah') }}">＋　Tambah Kuliner</a><a class="selected" href="{{ url('seller/profil') }}">♙　Profil Usaha</a><a href="{{ url('logout') }}">↪　Keluar</a></nav></aside><section class="seller-content"><div class="seller-top"><div><span class="eyebrow">Identitas mitra</span><h1>Profil Usaha</h1><p>Informasi ini membantu pengunjung mengenal dan menghubungi usahamu.</p></div></div><form method="post" class="seller-form seller-form-card"><label>Nama usaha<input name="nama_usaha" required value="{{ sellerProfile.nama_usaha|e }}"></label><label>Jenis usaha<input name="jenis_usaha" value="{{ sellerProfile.jenis_usaha|e }}"></label><label>Nomor telepon / WhatsApp<input name="nomor_telepon" value="{{ sellerProfile.nomor_telepon|e }}"></label><label class="full">Alamat usaha<textarea name="alamat" rows="4">{{ sellerProfile.alamat|e }}</textarea></label><div class="form-hint full">Status verifikasi: <b>{{ sellerProfile.verification_status|capitalize }}</b></div><button class="button" type="submit">Simpan profil</button></form></section></main>
{% endblock %}
