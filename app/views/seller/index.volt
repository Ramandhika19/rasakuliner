{% extends 'layouts/main.volt' %}
{% block content %}
<main class="seller-shell"><aside class="seller-sidebar">{% if sellerProfile.foto_profil %}<div class="seller-avatar"><img src="{{ url(sellerProfile.foto_profil) }}" alt="Foto profil"></div>{% else %}<div class="seller-avatar">{{ sellerName|slice(0,1)|upper }}</div>{% endif %}<b>{{ sellerProfile.nama_usaha|e }}</b><small>Area Seller</small><nav><a class="selected" href="{{ url('seller') }}">▦　Dashboard</a><a href="{{ url('seller/tambah') }}">＋　Tambah Kuliner</a><a href="{{ url('seller/profil') }}">♙　Profil Usaha</a><a href="{{ url('logout') }}">↪　Keluar</a></nav></aside>
<section class="seller-content"><div class="seller-top"><div><span class="eyebrow">Ruang pengelolaan</span><h1>Dashboard Seller</h1><p>Halo, {{ sellerName|e }}. Kelola kuliner dan pantau respons pengunjung di sini.</p></div><a class="button" href="{{ url('seller/tambah') }}">＋ Tambah Data</a></div>
<div class="seller-verification {{ sellerProfile.verification_status }}"><b>Status akun: {{ sellerProfile.verification_status|capitalize }}</b><span>{% if sellerProfile.verification_status == 'verified' %}Profil usaha telah diverifikasi.{% elseif sellerProfile.verification_status == 'rejected' %}Silakan periksa kembali data profil usaha.{% else %}Profil usaha menunggu verifikasi admin. Data kuliner yang dikirim juga perlu ditinjau sebelum tampil publik.{% endif %}</span></div>
<div class="seller-metrics"><article><small>Total kuliner</small><strong>{{ stats.total|default(0) }}</strong></article><article><small>Sudah tayang</small><strong>{{ stats.approved|default(0) }}</strong></article><article><small>Menunggu review</small><strong>{{ stats.pending|default(0) }}</strong></article><article><small>Total ulasan</small><strong>{{ reviewStats.total|default(0) }}</strong></article></div>
<div class="seller-section-head"><div><h2>Data kuliner saya</h2><p>Data baru akan ditinjau admin sebelum ditampilkan ke pengunjung.</p></div></div>
<div class="seller-table-wrap"><table class="seller-table"><thead><tr><th>Kuliner</th><th>Daerah</th><th>Status</th><th>Ulasan</th><th>Aksi</th></tr></thead><tbody>
{% for item in foods %}<tr><td><b>{{ item.nama|e }}</b><small>{{ item.kategori|e }}</small></td><td>{{ item.daerah|e }}</td><td><span class="status-pill {{ item.status }}">{{ item.status|capitalize }}</span>{% if item.rejection_reason %}<small>{{ item.rejection_reason|e }}</small>{% endif %}</td><td>{{ item.review_count }}<small>★ {{ item.avg_rating|default('—') }}</small></td><td><a href="{{ url('seller/edit/' ~ item.id) }}">Edit</a><form method="post" action="{{ url('seller/hapus/' ~ item.id) }}" onsubmit="return confirm('Hapus data kuliner ini?')"><button type="submit">Hapus</button></form></td></tr>
{% else %}<tr><td colspan="5" class="seller-empty">Belum ada data kuliner. Mulai dengan menambahkan makanan atau minuman khas usahamu.</td></tr>{% endfor %}
</tbody></table></div>
<div class="seller-review-note"><b>Ringkasan ulasan pengunjung</b><span>Rata-rata rating: <strong>★ {{ reviewStats.average|default('—') }}</strong> dari {{ reviewStats.total|default(0) }} ulasan.</span><p>Ulasan dan rating akan muncul di sini setelah pengunjung mengirim review pada halaman kuliner.</p></div>
</section></main>
{% endblock %}