{% extends 'layouts/main.volt' %}
{% block content %}
<main class="seller-shell"><aside class="seller-sidebar"><div class="seller-avatar">{{ sellerName|slice(0,1)|upper }}</div><b>{{ sellerProfile.nama_usaha|e }}</b><small>Area Seller</small><nav><a href="{{ url('seller') }}">▦　Dashboard</a><a class="selected" href="{{ url('seller/tambah') }}">＋　Tambah Kuliner</a><a href="{{ url('seller/profil') }}">♙　Profil Usaha</a><a href="{{ url('logout') }}">↪　Keluar</a></nav></aside><section class="seller-content"><a class="text-link" href="{{ url('seller') }}">← Kembali ke dashboard</a><div class="seller-top"><div><span class="eyebrow">Katalog usaha</span><h1>{{ food ? 'Edit data kuliner' : 'Tambah kuliner baru' }}</h1><p>Isi informasi makanan atau minuman khas yang ingin kamu promosikan.</p></div></div>
{% if error %}<div class="form-alert">{{ error|e }}</div>{% endif %}
<form method="post" class="seller-form seller-form-card"><label>Nama makanan / minuman<input name="nama" required value="{{ food.nama|default('')|e }}" placeholder="Contoh: Ayam Betutu"></label><label>Daerah asal<input name="daerah" required value="{{ food.daerah|default('')|e }}" placeholder="Contoh: Bali"></label><label>Kategori<input name="kategori" required value="{{ food.kategori|default('')|e }}" placeholder="Makanan berat, minuman, camilan..."></label><label>URL gambar<input type="url" name="gambar" required value="{{ food.gambar|default('')|e }}" placeholder="https://..."></label><label class="full">Deskripsi<textarea name="deskripsi" rows="5" required placeholder="Ceritakan keunikan, bahan, dan cita rasa kuliner ini...">{{ food.deskripsi|default('')|e }}</textarea></label><div class="form-hint full">Setelah disimpan, data berstatus <b>Menunggu</b> dan akan ditinjau admin sebelum tampil di website.</div><button class="button" type="submit">Simpan pengajuan →</button></form></section></main>
{% endblock %}
